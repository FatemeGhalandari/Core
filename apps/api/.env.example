NODE_ENV=development
PORT=4000

# Local Docker PostgreSQL
DATABASE_URL=postgresql://core:core_password@localhost:5432/core_db

# One frontend origin is enough for local development.
CLIENT_URL=http://localhost:5173

# Use this in production when you need one or more allowed frontend origins.
# Separate multiple origins with commas and do not include trailing slashes.
# CLIENT_URLS=https://your-core-web.vercel.app,https://www.your-domain.com
